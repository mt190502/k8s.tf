{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":ignoreModulesAndTests"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": [
    "after 12:00am and before 1:00am",
    "after 6:00am and before 7:00am",
    "after 12:00pm and before 1:00pm",
    "after 6:00pm and before 7:00pm"
  ],
  "updateNotScheduled": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 10,
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": false
  },
  "labels": ["dependencies"],
  "enabledManagers": ["custom.regex", "terraform"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions with renovate annotations",
      "managerFilePatterns": ["prod.values.hcl", "modules/**/*.tf"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)(\\s+registryUrl=(?<registryUrl>.*?))?\\s+\\w+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Update Terraform provider versions in terragrunt.hcl generate blocks",
      "managerFilePatterns": ["modules/**/terragrunt.hcl"],
      "matchStrings": [
        "\\w+\\s*=\\s*\\{\\s*source\\s*=\\s*\"(?<depName>[^\"]+)\"\\s*,\\s*version\\s*=\\s*\"(?<currentValue>[^\"]+)\"\\s*\\}"
      ],
      "datasourceTemplate": "terraform-provider",
      "versioningTemplate": "hashicorp"
    }
  ],
  "packageRules": [
    {
      "description": "Use the OpenTofu registry for Terraform providers",
      "matchDatasources": ["terraform-provider"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "description": "Ignore non-provider dependencies in the app template",
      "matchFileNames": ["modules/manifests/apps/template/**"],
      "enabled": false
    },
    {
      "description": "Allow provider updates in the app template",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["terraform-provider"],
      "matchFileNames": ["modules/manifests/apps/template/terragrunt.hcl"],
      "enabled": true
    },
    {
      "description": "Core Infrastructure (modules/infra)",
      "matchManagers": ["custom.regex", "terraform"],
      "matchFileNames": [
        "modules/infra/**",
        "prod.values.hcl"
      ],
      "groupName": "core-infrastructure",
      "groupSlug": "core-infrastructure",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "description": "Infra Manifests (modules/manifests/core)",
      "matchManagers": ["custom.regex", "terraform"],
      "matchFileNames": ["modules/manifests/core/**"],
      "groupName": "infra-manifests",
      "groupSlug": "infra-manifests",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "description": "Apps (modules/manifests/apps)",
      "matchManagers": ["custom.regex", "terraform"],
      "matchFileNames": ["modules/manifests/apps/**"],
      "groupName": "apps",
      "groupSlug": "apps",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "description": "Automerge patch updates for Docker images",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge minor updates for Helm charts",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Require approval for major Kubernetes updates",
      "matchPackageNames": ["kubernetes/kubernetes"],
      "matchUpdateTypes": ["major"],
      "labels": ["major-k8s-update"],
      "reviewers": ["team:platform"]
    },
    {
      "description": "Use loose versioning for app images without semver",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/mt190502/docker-anki-sync-server", "nightscout/cgm-remote-monitor"],
      "versioning": "loose"
    },
    {
      "description": "Renovate self-image: own branch, no self-upgrade churn inside the infra group",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "groupName": "renovate",
      "groupSlug": "renovate-self",
      "minimumReleaseAge": "7 days"
    }
  ],
  "ignoreDeps": ["busybox"],
  "pinDigests": false
}
