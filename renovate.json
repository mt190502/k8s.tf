{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":ignoreModulesAndTests"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": ["* 0,12 * * *"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 10,
  "rebaseWhen": "conflicted",
  "labels": ["dependencies"],
  "enabledManagers": ["custom.regex", "terraform", "github-actions"],
  "ignorePaths": ["modules/manifests/apps/template/**"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions in prod.values.hcl with renovate annotations",
      "managerFilePatterns": ["prod.values.hcl"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)(\\s+registryUrl=(?<registryUrl>.*?))?\\s+(?:version|talos|kubernetes|cilium|metrics_server|gateway_api)\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Update Terraform provider versions in terragrunt.hcl generate blocks",
      "managerFilePatterns": ["modules/**/terragrunt.hcl"],
      "matchStrings": [
        "(?<depName>\\w+/\\w+)\\s*=\\s*\\{[^}]*version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "terraform-provider"
    },
    {
      "customType": "regex",
      "description": "Update Docker images in Terraform files",
      "managerFilePatterns": ["modules/**/*.tf"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^:]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update Helm chart versions in helm.tf files",
      "managerFilePatterns": ["modules/**/helm.tf"],
      "matchStrings": [
        "repository\\s*=\\s*\"(?<registryUrl>[^\"]+)\"[\\s\\S]*?chart\\s*=\\s*\"(?<depName>[^\"]+)\"[\\s\\S]*?version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Update workflow tool versions with renovate annotations",
      "managerFilePatterns": [".github/workflows/*.yml", ".github/workflows/*.yaml"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)\\s*\\n\\s*[A-Za-z0-9_]+:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group infrastructure versions (Talos, Kubernetes, Cilium, Metrics Server, Gateway API)",
      "matchPackageNames": [
        "siderolabs/talos",
        "kubernetes/kubernetes",
        "cilium/cilium",
        "kubernetes-sigs/metrics-server",
        "kubernetes-sigs/gateway-api"
      ],
      "groupName": "infrastructure",
      "groupSlug": "infra-versions"
    },
    {
      "description": "Group core Helm charts",
      "matchDatasources": ["helm"],
      "matchPackageNames": [
        "cert-manager",
        "cloudnative-pg",
        "kube-prometheus-stack",
        "longhorn",
        "psmdb-operator",
        "reflector",
        "tailscale-operator"
      ],
      "groupName": "core-helm-charts",
      "groupSlug": "core-charts"
    },
    {
      "description": "Group application Docker images",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/mt190502/docker-anki-sync-server",
        "miniflux/miniflux",
        "nightscout/cgm-remote-monitor",
        "tomsquest/docker-radicale",
        "redmine",
        "ghcr.io/umami-software/umami"
      ],
      "groupName": "app-images",
      "groupSlug": "app-docker"
    },
    {
      "description": "Group Terraform providers",
      "matchDatasources": ["terraform-provider"],
      "groupName": "terraform-providers",
      "groupSlug": "tf-providers"
    },
    {
      "description": "Group GitHub Action updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "groupSlug": "gh-actions"
    },
    {
      "description": "Automerge patch updates for Docker images",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge minor updates for Helm charts",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Require approval for major Kubernetes updates",
      "matchPackageNames": ["kubernetes/kubernetes"],
      "matchUpdateTypes": ["major"],
      "labels": ["major-k8s-update"],
      "reviewers": ["team:platform"]
    },
    {
      "description": "Use loose versioning for app images without semver",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/mt190502/docker-anki-sync-server", "nightscout/cgm-remote-monitor"],
      "versioning": "loose"
    }
  ],
  "ignoreDeps": ["busybox"],
  "pinDigests": false
}
