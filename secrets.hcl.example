## ============================================================================================= ##
#  secrets.hcl.example --- Secret variable reference (HCL locals format)                          #
#                                                                                                 #
#  Copy this file to secrets.hcl and fill in the real values.                                     #
#  secrets.hcl is gitignored and never committed in plain text.                                   #
#  Use `make encrypt` / `make decrypt` to manage it with SOPS.                                    #
#                                                                                                 #
#  This file is read by prod.stack.hcl / dev.stack.hcl via:                                       #
#    read_terragrunt_config(get_env("TERRAGRUNT_SECRETS", ".../secrets.hcl")).locals              #
#                                                                                                 #
#  Each stack unit only consumes the variables it declares; unknown keys are                      #
#  silently ignored, so this single flat file is safe to pass to every unit.                      #
#                                                                                                 #
#  Usage:                                                                                         #
#    cp secrets.hcl.example secrets.hcl                                                           #
#    $EDITOR secrets.hcl                                                                          #
#    make plan                                             #~ picks up secrets.hcl automatically  #
#                                                                                                 #
#  To use a different path:                                                                       #
#    make plan SECRETS=/path/to/other.hcl                                                         #
## ============================================================================================= ##
locals {
  ## --------------------------------------------------------------------------------------------- ##
  #  Infra section                                                                                  #
  ## --------------------------------------------------------------------------------------------- ##
  infra = {
    ## --------------------------------------------------------------------------------------------- ##
    #  Hetzner Cloud                                                                                  #
    #  Used by: modules/infra/hetzner                                                                 #
    ## --------------------------------------------------------------------------------------------- ##
    hetzner = {
      api_token = "REPLACE_WITH_HETZNER_API_TOKEN"
    }

    ## --------------------------------------------------------------------------------------------- ##
    #  Cloudflare                                                                                     #
    #  Used by: modules/infra/cloudflare, modules/manifests/core/cert-manager                         #
    ## --------------------------------------------------------------------------------------------- ##
    cloudflare = {
      api_token = "REPLACE_WITH_CLOUDFLARE_API_TOKEN"
      zone_id   = "REPLACE_WITH_CLOUDFLARE_ZONE_ID"
    }

    ## --------------------------------------------------------------------------------------------- ##
    #  Tailscale                                                                                      #
    #  Used by: modules/infra/tailscale, modules/infra/talos                                          #
    ## --------------------------------------------------------------------------------------------- ##
    tailscale = {
      auth_key      = "tskey-auth-REPLACE_WITH_TAILSCALE_AUTH_KEY"
      client_id     = "REPLACE_WITH_TAILSCALE_CLIENT_ID"
      client_secret = "tskey-client-REPLACE_WITH_TAILSCALE_CLIENT_SECRET"
      tailnet       = "example.ts.net"
    }

  }

  ## --------------------------------------------------------------------------------------------- ##
  #  Manifests section                                                                              #
  ## --------------------------------------------------------------------------------------------- ##
  manifests = {
    ## --------------------------------------------------------------------------------------------- ##
    #  Apps                                                                                           #
    #  Used by: manifests/apps                                                                        #
    ## --------------------------------------------------------------------------------------------- ##
    apps = {
      anki = {
        app = {
          accounts = [
            {
              username = "user"
              password = "REPLACE_WITH_PASSWORD"
            }
          ]
        }
      }
      gotify = {
        app = {
          password = "REPLACE_WITH_PASSWORD"
        }
        bridges = {
          alertmanager = {
            token = "REPLACE_WITH_GOTIFY_ALERTMANAGER_BRIDGE_TOKEN"
          }
          loki = {
            token = "REPLACE_WITH_GOTIFY_LOKI_BRIDGE_TOKEN"
          }
        }
      }
      miniflux = {
        app = {
          admin_username = "admin"
          admin_password = "REPLACE_WITH_PASSWORD"
        }
        pg = {
          password = "REPLACE_WITH_PG_PASSWORD"
        }
      }
      nightscout = {
        app = {
          api_secret = "REPLACE_WITH_API_SECRET"
        }
      }
      radicale = {
        username = "admin"
        password = "REPLACE_WITH_PASSWORD"
      }
      redmine = {
        pg = {
          password = "REPLACE_WITH_PG_PASSWORD"
        }
      }
      syncstorage_rs = {
        app = {
          master_secret = "REPLACE_WITH_MASTER_SECRET"
        }
        pg = {
          password = "REPLACE_WITH_PG_PASSWORD"
        }
      }
      umami = {
        app = {
          app_secret = "REPLACE_WITH_APP_SECRET"
        }
        pg = {
          password = "REPLACE_WITH_PG_PASSWORD"
        }
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Miscellaneous secrets                                                                          #
      ## --------------------------------------------------------------------------------------------- ##
      misc = {
        basic_auth = {
          username      = "admin"
          password_hash = "REPLACE_WITH_HTPASSWD_HASH"
        }
      }
    }
    core = {
      atlantis = {
        aws_access_key         = "REPLACE_WITH_AWS_ACCESS_KEY"
        aws_s3_bucket          = "REPLACE_WITH_AWS_BUCKET_NAME"
        aws_s3_endpoint        = "REPLACE_WITH_AWS_ENDPOINT"
        aws_secret_key         = "REPLACE_WITH_AWS_SECRET_KEY"
        github_app_key         = <<-EOT
          REPLACE_WITH_GITHUB_APP_KEY
        EOT
        github_app_id          = "REPLACE_WITH_GITHUB_APP_ID"
        github_installation_id = "REPLACE_WITH_GITHUB_APP_INSTALLATION_ID"
        sops_age_key           = "REPLACE_WITH_SOPS_AGE_KEY"
        tf_encryption_pass     = "REPLACE_WITH_TF_ENCRYPTION_PASS"
        webhook_secret         = "REPLACE_WITH_WEBHOOK_SECRET"
      }
      kube_prometheus_stack = {
        alertmanager = {
          discord_webhook_url = "REPLACE_WITH_DISCORD_WEBHOOK_URL"
        }
      }
      loki = {
        access_key_id     = "REPLACE_WITH_S3_ACCESS_KEY_ID"
        secret_access_key = "REPLACE_WITH_S3_SECRET_ACCESS_KEY"
      }
      longhorn = {
        access_key_id     = "REPLACE_WITH_S3_ACCESS_KEY_ID"
        endpoints         = "REPLACE_WITH_S3_ENDPOINT"
        secret_access_key = "REPLACE_WITH_S3_SECRET_ACCESS_KEY"
      }
    }
  }
}
