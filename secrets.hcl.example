## ============================================================================================= ##
#  secrets.hcl.example --- Secret variable reference (HCL locals format)                          #
#                                                                                                 #
#  Copy this file to secrets.hcl and fill in the real values.                                     #
#  secrets.hcl is gitignored and never committed in plain text.                                   #
#  Use `make encrypt` / `make decrypt` to manage it with SOPS.                                    #
#                                                                                                 #
#  This file is read by the root terragrunt.stack.hcl via:                                        #
#    read_terragrunt_config(get_env("TERRAGRUNT_SECRETS", ".../secrets.hcl")).locals              #
#  The Makefile defaults TERRAGRUNT_SECRETS to $(PWD)/$(ENV).secrets.hcl (prod.secrets.hcl).      #
#                                                                                                 #
#  Each stack unit only consumes the variables it declares; unknown keys are                      #
#  silently ignored, so this single flat file is safe to pass to every unit.                      #
#                                                                                                 #
#  Usage:                                                                                         #
#    cp secrets.hcl.example secrets.hcl                                                           #
#    $EDITOR secrets.hcl                                                                          #
#    make plan                                             #~ picks up secrets.hcl automatically  #
#                                                                                                 #
#  To use a different path:                                                                       #
#    make plan SECRETS=/path/to/other.hcl                                                         #
## ============================================================================================= ##
locals {
  ## --------------------------------------------------------------------------------------------- ##
  #  Infra section                                                                                  #
  ## --------------------------------------------------------------------------------------------- ##
  infra = {
    ## --------------------------------------------------------------------------------------------- ##
    #  Hetzner Cloud                                                                                  #
    #  Used by: modules/infra/hetzner/post                                                            #
    ## --------------------------------------------------------------------------------------------- ##
    hetzner = {
      api_token = "REPLACE_WITH_HETZNER_API_TOKEN"
    }

    ## --------------------------------------------------------------------------------------------- ##
    #  Cloudflare                                                                                     #
    #  Used by: modules/infra/cloudflare/post, modules/manifests/core/cert-manager                    #
    ## --------------------------------------------------------------------------------------------- ##
    cloudflare = {
      api_token = "REPLACE_WITH_CLOUDFLARE_API_TOKEN"
      zone_id   = "REPLACE_WITH_CLOUDFLARE_ZONE_ID"
    }

    ## --------------------------------------------------------------------------------------------- ##
    #  Tailscale                                                                                      #
    #  Used by: modules/infra/tailscale/post, modules/infra/talos/pre,                                #
    #           modules/manifests/core/tailscale-operator                                             #
    ## --------------------------------------------------------------------------------------------- ##
    tailscale = {
      auth_key      = "tskey-auth-REPLACE_WITH_TAILSCALE_AUTH_KEY"
      client_id     = "REPLACE_WITH_TAILSCALE_OAUTH_CLIENT_ID"
      client_secret = "tskey-client-REPLACE_WITH_TAILSCALE_OAUTH_CLIENT_SECRET"
      tailnet       = "example.ts.net"
    }

  }

  ## --------------------------------------------------------------------------------------------- ##
  #  Manifests section                                                                              #
  ## --------------------------------------------------------------------------------------------- ##
  manifests = {
    apps = {
      ## --------------------------------------------------------------------------------------------- ##
      #  Anki --- user accounts (username:password pairs baked into ACCOUNT n entries)                  #
      #  Used by: modules/manifests/apps/anki                                                           #
      ## --------------------------------------------------------------------------------------------- ##
      anki = {
        app = {
          accounts = [
            {
              username = "user"
              password = "REPLACE_WITH_PASSWORD"
            }
          ]
        }
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Hedgedoc --- session signing secret                                                            #
      #  Used by: modules/manifests/apps/hedgedoc                                                       #
      ## --------------------------------------------------------------------------------------------- ##
      hedgedoc = {
        app = {
          session_secret = "REPLACE_WITH_SESSION_SECRET"
        }
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Miniflux --- admin credentials and database password                                           #
      #  Used by: modules/manifests/apps/miniflux                                                       #
      ## --------------------------------------------------------------------------------------------- ##
      miniflux = {
        app = {
          admin_username = "admin"
          admin_password = "REPLACE_WITH_PASSWORD"
        }
        pg = {
          password = "REPLACE_WITH_PG_PASSWORD"
        }
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Nightscout --- API secret and MongoDB password                                                 #
      #  Used by: modules/manifests/apps/nightscout                                                     #
      ## --------------------------------------------------------------------------------------------- ##
      nightscout = {
        app = {
          api_secret = "REPLACE_WITH_API_SECRET"
        }
        mongo = {
          password = "REPLACE_WITH_MONGO_PASSWORD"
        }
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Picoshare --- shared upload passphrase                                                         #
      #  Used by: modules/manifests/apps/picoshare                                                      #
      ## --------------------------------------------------------------------------------------------- ##
      picoshare = {
        shared_secret = "REPLACE_WITH_PICOSHARE_SHARED_SECRET"
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Radicale --- basic auth credentials                                                            #
      #  Used by: modules/manifests/apps/radicale                                                       #
      ## --------------------------------------------------------------------------------------------- ##
      radicale = {
        username = "admin"
        password = "REPLACE_WITH_PASSWORD"
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Redmine --- database password and task-sync service credentials                                #
      #  Used by: modules/manifests/apps/redmine                                                        #
      ## --------------------------------------------------------------------------------------------- ##
      redmine = {
        task_sync_adapter = {
          redmine_api_key   = "REPLACE_WITH_REDMINE_API_KEY"
          radicale_username = "REPLACE_WITH_RADICALE_USERNAME"
          radicale_password = "REPLACE_WITH_RADICALE_PASSWORD"
        }
        pg = {
          password = "REPLACE_WITH_PG_PASSWORD"
        }
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Silverbullet --- MCP bearer token (32-256 chars required when MCP is public)                   #
      #  Used by: modules/manifests/apps/silverbullet                                                   #
      ## --------------------------------------------------------------------------------------------- ##
      silverbullet = {
        mcp = {
          token = "REPLACE_WITH_SILVERBULLET_MCP_TOKEN"
        }
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Slimserve --- basic auth for the gateway route                                                 #
      #  Used by: modules/manifests/apps/slimserve                                                      #
      ## --------------------------------------------------------------------------------------------- ##
      slimserve = {
        basic_auth = {
          username      = "user"
          password_hash = "REPLACE_WITH_HTPASSWD_HASH"
        }
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Syncstorage-rs --- master secret and database password                                         #
      #  Used by: modules/manifests/apps/syncstorage-rs                                                 #
      ## --------------------------------------------------------------------------------------------- ##
      syncstorage_rs = {
        app = {
          master_secret = "REPLACE_WITH_MASTER_SECRET"
        }
        pg = {
          password = "REPLACE_WITH_PG_PASSWORD"
        }
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Umami --- app secret and database password                                                     #
      #  Used by: modules/manifests/apps/umami                                                          #
      ## --------------------------------------------------------------------------------------------- ##
      umami = {
        app = {
          app_secret = "REPLACE_WITH_APP_SECRET"
        }
        pg = {
          password = "REPLACE_WITH_PG_PASSWORD"
        }
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Miscellaneous secrets                                                                          #
      #  Used by: apps.misc.basic_auth is the shared fallback for every unit that supports              #
      #  basic_auth (atlantis, kube-prometheus-stack, redmine, silverbullet, hedgedoc, umami).          #
      #  Each app may override it with manifests.apps.<app>.basic_auth.                                 #
      ## --------------------------------------------------------------------------------------------- ##
      misc = {
        basic_auth = {
          username      = "admin"
          password_hash = "REPLACE_WITH_HTPASSWD_HASH"
        }
      }
    }
    core = {
      ## --------------------------------------------------------------------------------------------- ##
      #  Atlantis --- S3 backend, GitHub App, SOPS age key, TF state encryption and webhook secret      #
      #  Used by: modules/manifests/core/atlantis                                                       #
      ## --------------------------------------------------------------------------------------------- ##
      atlantis = {
        aws_access_key         = "REPLACE_WITH_AWS_ACCESS_KEY"
        aws_s3_bucket          = "REPLACE_WITH_AWS_BUCKET_NAME"
        aws_s3_endpoint        = "REPLACE_WITH_AWS_ENDPOINT"
        aws_secret_key         = "REPLACE_WITH_AWS_SECRET_KEY"
        github_app_key         = <<-EOT
          REPLACE_WITH_GITHUB_APP_KEY
        EOT
        github_app_id          = "REPLACE_WITH_GITHUB_APP_ID"
        github_installation_id = "REPLACE_WITH_GITHUB_APP_INSTALLATION_ID"
        sops_age_key           = "REPLACE_WITH_SOPS_AGE_KEY"
        tf_encryption_pass     = "REPLACE_WITH_TF_ENCRYPTION_PASS"
        webhook_secret         = "REPLACE_WITH_WEBHOOK_SECRET"
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Gotify --- admin password, PostgreSQL password and bridge tokens                               #
      #  Used by: modules/manifests/core/gotify                                                         #
      #  Bridges is a free-form map(object({token})); each key deploys a gotify bridge                  #
      #  deployment, except "alertmanager", which also creates "alertmanager-info".                     #
      #  Its Discord webhook is stored with kube_prometheus_stack.alertmanager below.                   #
      ## --------------------------------------------------------------------------------------------- ##
      gotify = {
        app = {
          password = "REPLACE_WITH_PASSWORD"
        }
        bridges = {
          alertmanager = {
            token = "REPLACE_WITH_GOTIFY_ALERTMANAGER_BRIDGE_TOKEN"
          }
          loki = {
            token = "REPLACE_WITH_GOTIFY_LOKI_BRIDGE_TOKEN"
          }
        }
        pg = {
          password = "REPLACE_WITH_PG_PASSWORD"
        }
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Kube-prometheus-stack --- shared fallback alertmanager webhook for Gotify                      #
      #  Used by: modules/manifests/core/gotify (Discord adapter)                                       #
      ## --------------------------------------------------------------------------------------------- ##
      kube_prometheus_stack = {
        alertmanager = {
          discord_webhook_url = "REPLACE_WITH_DISCORD_WEBHOOK_URL"
        }
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Loki --- S3 storage credentials                                                                #
      #  Used by: modules/manifests/core/loki                                                           #
      ## --------------------------------------------------------------------------------------------- ##
      loki = {
        access_key_id     = "REPLACE_WITH_S3_ACCESS_KEY_ID"
        secret_access_key = "REPLACE_WITH_S3_SECRET_ACCESS_KEY"
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Longhorn --- S3 backup credentials                                                             #
      #  Used by: modules/manifests/core/longhorn                                                       #
      ## --------------------------------------------------------------------------------------------- ##
      longhorn = {
        access_key_id     = "REPLACE_WITH_S3_ACCESS_KEY_ID"
        endpoints         = "REPLACE_WITH_S3_ENDPOINT"
        secret_access_key = "REPLACE_WITH_S3_SECRET_ACCESS_KEY"
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  Renovate --- GitHub App credentials and platform token                                         #
      #  Used by: modules/manifests/core/renovate                                                       #
      ## --------------------------------------------------------------------------------------------- ##
      renovate = {
        app_id              = "REPLACE_WITH_GITHUB_APP_ID"
        app_installation_id = "REPLACE_WITH_GITHUB_APP_INSTALLATION_ID"
        private_key         = <<-EOT
          -----BEGIN RSA PRIVATE KEY-----
          REPLACE_WITH_GITHUB_APP_PRIVATE_KEY
          -----END RSA PRIVATE KEY-----
        EOT
        github_com_token    = "REPLACE_WITH_READ_ONLY_GITHUB_COM_TOKEN"
      }

      ## --------------------------------------------------------------------------------------------- ##
      #  S3 CSI --- object storage credentials (Garage)                                                 #
      #  Used by: modules/manifests/core/s3-csi                                                         #
      ## --------------------------------------------------------------------------------------------- ##
      s3_csi = {
        access_key_id     = "REPLACE_WITH_S3_ACCESS_KEY_ID"
        secret_access_key = "REPLACE_WITH_S3_SECRET_ACCESS_KEY"
      }
    }
  }
}
